# --- datos ---
# Los snapshots crudos NO se versionan. Ver data/manifests/ y docs/METHODOLOGY.md.
data/raw/**
!data/raw/.gitkeep
data/interim/**
!data/interim/.gitkeep

# Los artefactos grandes de runtime no se versionan si superan el presupuesto.
# Se registran (path, size, sha256) en evidence/g0/04-tiles/RETENTION.md
app/static/data/**/*.pmtiles
app/static/data/*.pmtiles
app/static/data/*.mbtiles

# Vendor generado desde node_modules por scripts/copy-maplibre-worker.mjs (predev/prebuild)
app/static/vendor/

# Intermedios de tiles (GeoJSON regenerables). Los *.parquet SÍ se versionan.
data/processed/g0/*.geojson
data/processed/g0/*.fc.geojson
data/processed/g1/geojson/

# --- python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- node / sveltekit ---
node_modules/
app/build/
app/.svelte-kit/
app/.vercel/
app/.netlify/
*.log

# --- entorno ---
.env
.env.*
!.env.example

# --- editores / sistema ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- temporales ---
tmp/
*.tmp

# G3-B: snapshots de planeamiento — geometrias crudas no versionadas (786MB).
# Se registran sha256 en data/snapshots/planning_*/manifest.json.
data/snapshots/planning_*/wfs/

# G3-D: snapshot de contexto — geometria WFS cruda no versionada (67MB).
# Se registran sha256 en data/snapshots/context_*/manifest.json.
data/snapshots/context_*/wfs/

# scratch local (worktrees perf, tmp)
.scratch/
