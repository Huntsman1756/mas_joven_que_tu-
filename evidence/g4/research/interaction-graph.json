{
  "generated": "G4-R research — modelo de estado real (app.svelte.ts + url.ts + +page.svelte)",
  "url_params": {
    "year": "año personal (1900..snapshot)",
    "place": "slug municipal",
    "lat/lon/z": "cámara del mapa",
    "ortho": "año de campaña ortofoto visible sobre el mapa",
    "building": "id catastral (nunca texto de dirección — privacidad GA4)",
    "play": "cabezal temporal pausado (solo eventos discretos, nunca por frame)",
    "view": "map|time|photo (map se omite)",
    "compare": "segundo ancla temporal DOS AÑOS"
  },
  "not_in_url": [
    "histMapVisible/histMapState — el mapa 1923-25 no es compartible ni restaurable",
    "orthoCompare (segunda campaña del comparador) — se pierde al compartir",
    "contextOverlay activo — la overlay contextual no se serializa",
    "planningHighlight — la overlay de planeamiento no se serializa",
    "selectedCell — el detalle de celda no se serializa",
    "addressResult/identityPoint — texto de dirección nunca en URL (correcto: privacidad)",
    "address search step (formulario abierto/cerrado) — no serializado",
    "playing — nunca se comparte reproducción en curso (correcto)"
  ],
  "nodes": [
    {"id": "intro.landing", "label": "Hero: año + lugar"},
    {"id": "intro.place_typing", "label": "listbox de municipios"},
    {"id": "boot.error", "label": "error de arranque (catálogo/municipios)"},
    {"id": "result.loading", "label": "resolución de lugar + métricas en vuelo"},
    {"id": "result.ready.map", "label": "headline + mapa (vista por defecto)"},
    {"id": "result.map.cell", "label": "tooltip/detalle de celda"},
    {"id": "result.map.building", "label": "edificio seleccionado (building=)"},
    {"id": "result.time", "label": "vista TIEMPO (playYear pausado/playing)"},
    {"id": "result.photo", "label": "vista FOTO (PhotoPanel)"},
    {"id": "result.ortho_overlay", "label": "ortofoto opt-in sobre MAPA"},
    {"id": "result.ortho_compare", "label": "comparador dos campañas"},
    {"id": "result.histmap", "label": "mapa histórico 1923-25 opt-in"},
    {"id": "result.address.*", "label": "flujo MI EDIFICIO (street→portal→identity)"},
    {"id": "result.compare", "label": "DOS AÑOS activo (compare=)"},
    {"id": "result.planning.muni", "label": "planeamiento municipal"},
    {"id": "result.planning.local", "label": "planeamiento local del edificio"},
    {"id": "result.context", "label": "módulos de entorno (ruido/paradas/monte)"},
    {"id": "result.overlay.planning", "label": "highlight de planeamiento (excluyente)"},
    {"id": "result.overlay.context", "label": "overlay contextual (excluyente)"},
    {"id": "metrics.error", "label": "fallo de métricas del lugar"}
  ],
  "edges": [
    {"from": "intro.landing", "action": "submit año+lugar", "to": "result.loading", "url": "pushState ?year&place", "net": "metrics/<slug>.json + preloadMapEngine", "camera": "municipio", "back": "vuelve a intro"},
    {"from": "result.loading", "action": "metrics resuelto", "to": "result.ready.map"},
    {"from": "result.ready.map", "action": "tap celda", "to": "result.map.cell", "url": "no", "back": "no restaurable"},
    {"from": "result.map.cell", "action": "'Ver datos de esta zona'", "to": "CellDetail persistente"},
    {"from": "result.ready.map", "action": "tap edificio", "to": "result.map.building", "url": "building=", "net": "planning/<mun>.json + context/<mun>.json (auto)", "back": "sí (building= en URL)"},
    {"from": "result.ready.map", "action": "ViewSwitch→TIEMPO", "to": "result.time", "url": "view=time", "mutation": "playYear=year si null"},
    {"from": "result.time", "action": "Play", "to": "playing", "url": "play= solo en eventos discretos", "back": "parcial"},
    {"from": "result.time", "action": "scrub/step/campaign-mark", "to": "result.time", "url": "play=", "net": "campaign-mark → ortho proposal"},
    {"from": "result.ready.map", "action": "ViewSwitch→FOTO", "to": "result.photo", "url": "view=photo", "net": "probe WMS + tiles ortofoto", "states": "loading|available|not_covered|service_error"},
    {"from": "result.photo", "action": "cambiar campaña", "to": "result.photo", "url": "ortho=<year>"},
    {"from": "result.photo", "action": "comparar campañas", "to": "result.ortho_compare", "url": "NO se serializa orthoCompare"},
    {"from": "result.ready.map", "action": "OrthoControls 'Ver foto'", "to": "result.ortho_overlay", "url": "ortho=", "net": "probe WMS + tiles"},
    {"from": "result.ready.map", "action": "HistMapControls 'Ver mapa histórico'", "to": "result.histmap", "url": "NO se serializa", "net": "probe export + tiles 1923-25"},
    {"from": "result.ready.map", "action": "AddressSearch start", "to": "result.address.open"},
    {"from": "result.address.open", "action": "buscar calle", "to": "street candidates", "net": "NORA t17i (externo)"},
    {"from": "street candidates", "action": "elegir calle + portal", "to": "portal/variantes", "net": "NORA portales"},
    {"from": "portal seleccionado", "action": "resolver identidad", "to": "result.map.building", "net": "tiles catastro (identity)", "url": "building=", "states": "EXACT|MULTIPLE|NORA_ONLY|NOT_FOUND"},
    {"from": "result.ready.map", "action": "CompareYear apply", "to": "result.compare", "url": "compare="},
    {"from": "result.map.building", "action": "opt-in highlight planeamiento", "to": "result.overlay.planning", "net": "planning-geom/<mun>.json", "exclusion": "contextOverlay→null"},
    {"from": "result.context", "action": "opt-in overlay (ruido|paradas|montes)", "to": "result.overlay.context", "net": "context-geom/<mun>-<mod>.json", "exclusion": "planningHighlight→null"},
    {"from": "*", "action": "Cambiar año o lugar", "to": "form inline", "url": "year= / place= nuevo", "side_effects": "selectPlace resetea TODA la profundidad (building, compare, ortho, histmap, context)"},
    {"from": "*", "action": "Compartir", "to": "mismo estado", "fx": "clipboard URL"},
    {"from": "*", "action": "browser Back/Forward", "to": "applyUrl(parseUrl)", "notes": "placeSeq last-write-wins; solo estados serializados restauran"},
    {"from": "result.*", "action": "reset (intro)", "to": "intro.landing", "url": "limpio"}
  ],
  "findings": [
    "3 caminos a la ortofoto: marcas de campaña en timeline → OrthoControls → modo FOTO",
    "histMapVisible no se serializa: una vista con histórico activo NO es compartible ni restaura con Back",
    "orthoCompare no se serializa: el comparador se pierde al compartir",
    "selectedCell no se serializa: detalle de celda no compartible",
    "selectPlace() resetea 20+ campos: cambiar de lugar destruye building/compare/ortho/histmap/context (diseñado, pero un cambio accidental de lugar es destructivo)",
    "pendingBuildingId mantiene building= durante el restore — si falla cerrado el param cae (fail-closed correcto)",
    "contextOverlay/planningHighlight mutuamente excluyentes en el estado (setContextOverlay limpia planningHighlight)",
    "playYear persiste al cambiar de vista (regla determinista documentada)",
    "placeSeq last-write-wins protege races de resolvePlace"
  ]
}
