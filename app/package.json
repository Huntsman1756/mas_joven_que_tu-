{
  "name": "mas-joven-que-tu",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "build": "vite build && node scripts/gen-engine-preload.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "preview": "vite preview --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\"",
    "test": "vitest run && node --test scripts/static-server.test.mjs",
    "test:watch": "vitest",
    "serve": "node scripts/static-server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "maplibre-gl": "6.10.0",
    "maplibre-gl-swipe": "0.11.3",
    "pmtiles": "4.5.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
