# Line endings: LF everywhere (prettier endOfLine=lf; los scripts .ps1/.sh
# funcionan igual con LF en PowerShell 7 / bash).
* text=auto eol=lf

# Binarios: nunca tocar los finales de línea.
*.pmtiles binary
*.mbtiles binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.pdf binary
*.woff2 binary
*.ico binary

# Snapshots de evidencia: bytes exactos servidos por el editor — el
# sha256 del manifest se calcula sobre ellos (incl. CRLF); normalizar
# EOL cambiaría el hash y rompería la verificación (scripts/verify_street_source.py).
evidence/callejero/*.csv binary
